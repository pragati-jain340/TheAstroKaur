# Add these to .env.local and Vercel; do not commit real values.
# Keep the existing Supabase and Resend variables already configured.
NEXT_PUBLIC_SITE_URL=https://your-vercel-site.example
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match NEXT_PUBLIC_SITE_URL + /api/google/callback exactly.
# Local: http://localhost:3000/api/google/callback
GOOGLE_REDIRECT_URI=https://your-vercel-site.example/api/google/callback
# Generate 32 random bytes encoded as base64. Keep stable across redeployments.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Generate a separate random value with at least 32 characters.
BOOKING_WORKER_SECRET=
# Optional overrides; existing Resend sender and CONTACT_EMAIL are reused otherwise.
BOOKING_FROM_EMAIL=
BOOKING_REPLY_TO=
BOOKING_OWNER_EMAIL=
